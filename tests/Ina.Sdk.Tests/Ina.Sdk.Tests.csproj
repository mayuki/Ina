<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Ina.Sdk.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Utilities.Core" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ina.Linker\Ina.Linker.csproj" />
    <ProjectReference Include="..\..\src\Ina.Sdk\Ina.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The inputs of the link task are assembled in memory with the helpers of the linker tests. -->
    <Compile Include="..\Ina.Linker.Tests\Support\Code.cs" Link="Support\Code.cs" />
    <Compile Include="..\Ina.Linker.Tests\Support\ElfImage.cs" Link="Support\ElfImage.cs" />
    <Compile Include="..\Ina.Linker.Tests\Support\ElfObjectBuilder.cs" Link="Support\ElfObjectBuilder.cs" />
    <Compile Include="..\Ina.Linker.Tests\Support\MachObjectBuilder.cs" Link="Support\MachObjectBuilder.cs" />
    <Compile Include="..\Ina.Linker.Tests\Support\MachOImage.cs" Link="Support\MachOImage.cs" />
    <Compile Include="..\Ina.Linker.Tests\Support\PeImage.cs" Link="Support\PeImage.cs" />
    <Compile Include="..\Ina.Linker.Tests\Support\WindowsCode.cs" Link="Support\WindowsCode.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- For the test that compares the version in the documentation with the version of the packages. -->
    <AssemblyMetadata Include="RepositoryDirectory" Value="$(MSBuildThisFileDirectory)..\.." />
    <AssemblyMetadata Include="PackageVersion" Value="$(Version)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
