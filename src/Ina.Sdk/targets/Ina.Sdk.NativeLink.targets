<!--
  Replaces the part of the NativeAOT targets (Microsoft.NETCore.Native.targets, and Microsoft.NETCore.Native.Unix.targets
  or Microsoft.NETCore.Native.Windows.targets of the Microsoft.DotNet.ILCompiler package) that depends on a native
  toolchain. Everything up to and including the compilation with ILCompiler, and the publish steps after the link,
  stay as they are.

  Two targets are redefined, which works because this file is imported after the originals:

  - SetupOSSpecificProps selects the runtime libraries to link. The original also looks for clang, gcc and objcopy,
    or for Visual Studio with link.exe and the Windows SDK, and fails if they are missing.
  - LinkNative runs the linker. The original calls clang, and afterwards objcopy, or dsymutil and strip for macOS;
    for Windows it calls link.exe.
-->
<Project>

  <PropertyGroup>
    <!-- Ina's linker does not write debug information yet, so ILCompiler does not need to generate it. -->
    <NativeDebugSymbols>false</NativeDebugSymbols>

    <!-- Settable from outside, so that a build of the source tree can be tried without packaging it (see docs/Development.md). -->
    <InaTasksAssembly Condition="'$(InaTasksAssembly)' == ''">$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', 'tasks', 'net11.0', 'Ina.Sdk.dll'))</InaTasksAssembly>
    <_InaLinkOptionsFile>$(NativeIntermediateOutputPath)$(TargetName).ina.rsp</_InaLinkOptionsFile>
  </PropertyGroup>

  <!-- The linker is a .NET library; Runtime="NET" lets MSBuild on .NET Framework (Visual Studio) run the task in a .NET process. -->
  <UsingTask TaskName="Ina.Sdk.InaLink" AssemblyFile="$(InaTasksAssembly)" Runtime="NET" />

  <!--
    ILCompiler turns P/Invokes into the libraries listed as DirectPInvoke into direct calls, which is why the target
    is a dependency of the compilation as well. The system libraries themselves are not listed, because the import
    table of the linker knows which one exports a symbol.
  -->
  <Target Name="SetupOSSpecificProps" DependsOnTargets="$(IlcDynamicBuildPropertyDependencies);_InaSelectUnixLibraries;_InaSelectWindowsLibraries" />

  <!--
    The libraries of an executable that is linked dynamically against the system libraries only, in the order of
    the original target: the native parts of the framework first, then the runtime they depend on. Linux and macOS
    differ in the library that implements cryptography: OpenSSL for Linux, Apple's frameworks for macOS.
  -->
  <Target Name="_InaSelectUnixLibraries" Condition="'$(_InaTargetsWindows)' != 'true'">

    <PropertyGroup>
      <FullRuntimeName>libRuntime.WorkstationGC</FullRuntimeName>
      <FullRuntimeName Condition="'$(ServerGarbageCollection)' == 'true' or '$(IlcLinkServerGC)' == 'true'">libRuntime.ServerGC</FullRuntimeName>
      <EventPipeName>libeventpipe-disabled</EventPipeName>
      <EventPipeName Condition="'$(EventSourceSupport)' == 'true'">libeventpipe-enabled</EventPipeName>
      <VxSortSupportName>libRuntime.VxsortDisabled</VxSortSupportName>
      <VxSortSupportName Condition="'$(OptimizationPreference)' == 'Speed' or '$(IlcEnableVxsort)' == 'true'">libRuntime.VxsortEnabled</VxSortSupportName>
      <StandaloneGCSupportName>libstandalonegc-disabled</StandaloneGCSupportName>
      <StandaloneGCSupportName Condition="'$(IlcStandaloneGCSupport)' == 'true'">libstandalonegc-enabled</StandaloneGCSupportName>
    </PropertyGroup>

    <ItemGroup>
      <NetCoreAppNativeLibrary Include="System.Native" />
      <NetCoreAppNativeLibrary Include="System.Globalization.Native" Condition="'$(InvariantGlobalization)' != 'true'" />
      <NetCoreAppNativeLibrary Include="System.IO.Compression.Native" />
      <NetCoreAppNativeLibrary Include="System.Net.Security.Native" />
      <NetCoreAppNativeLibrary Include="System.Security.Cryptography.Native.OpenSsl" Condition="'$(_InaTargetsMacOS)' != 'true'" />
      <NetCoreAppNativeLibrary Include="System.Security.Cryptography.Native.Apple" Condition="'$(_InaTargetsMacOS)' == 'true'" />
    </ItemGroup>

    <ItemGroup>
      <DirectPInvoke Include="@(NetCoreAppNativeLibrary)" />
      <NativeLibrary Include="@(NetCoreAppNativeLibrary->'$(IlcFrameworkNativePath)lib%(Identity).a')" />

      <NativeLibrary Include="$(IlcSdkPath)libbootstrapper.o" />
      <NativeLibrary Include="$(IlcSdkPath)$(FullRuntimeName).a" />
      <NativeLibrary Include="$(IlcSdkPath)$(EventPipeName).a" />
      <!-- The vectorized sort exists for x64, and since .NET 11 for arm64 as well. -->
      <NativeLibrary Include="$(IlcSdkPath)$(VxSortSupportName).a" Condition="Exists('$(IlcSdkPath)$(VxSortSupportName).a')" />
      <NativeLibrary Include="$(IlcSdkPath)$(StandaloneGCSupportName).a" />
      <NativeLibrary Include="$(IlcSdkPath)libaotminipal.a" />
      <NativeLibrary Include="$(IlcSdkPath)libstdc++compat.a" />

      <!-- zlib, brotli and (since .NET 11) zstd follow System.IO.Compression.Native, which refers to them. -->
      <NativeLibrary Include="$(IlcFrameworkNativePath)libzstd.a" Condition="Exists('$(IlcFrameworkNativePath)libzstd.a')" />
      <NativeLibrary Include="$(IlcFrameworkNativePath)libz.a" />
      <NativeLibrary Include="$(IlcFrameworkNativePath)libbrotlienc.a" />
      <NativeLibrary Include="$(IlcFrameworkNativePath)libbrotlidec.a" />
      <NativeLibrary Include="$(IlcFrameworkNativePath)libbrotlicommon.a" />
    </ItemGroup>
  </Target>

  <!--
    The same for Windows, in the order of the original target: the runtime first, then the native parts of the
    framework. On Windows most of the platform abstraction is managed code that calls the system directly, so only
    two native parts are left. The import libraries of the Windows SDK that the original passes to link.exe
    (SdkNativeLibrary) are not needed: the import table of the linker takes their place. What the original does
    without a toolchain is kept: it tells ILCompiler which Windows APIs exist on every supported version, so that
    P/Invokes into them become direct references that the linker binds.
  -->
  <Target Name="_InaSelectWindowsLibraries" Condition="'$(_InaTargetsWindows)' == 'true'">

    <PropertyGroup>
      <FullRuntimeName>Runtime.WorkstationGC</FullRuntimeName>
      <FullRuntimeName Condition="'$(ServerGarbageCollection)' == 'true' or '$(IlcLinkServerGC)' == 'true'">Runtime.ServerGC</FullRuntimeName>
      <EventPipeName>eventpipe-disabled</EventPipeName>
      <EventPipeName Condition="'$(EventSourceSupport)' == 'true'">eventpipe-enabled</EventPipeName>
      <VxSortSupportName>Runtime.VxsortDisabled</VxSortSupportName>
      <VxSortSupportName Condition="'$(OptimizationPreference)' == 'Speed' or '$(IlcEnableVxsort)' == 'true'">Runtime.VxsortEnabled</VxSortSupportName>
      <StandaloneGCSupportName>standalonegc-disabled</StandaloneGCSupportName>
      <StandaloneGCSupportName Condition="'$(IlcStandaloneGCSupport)' == 'true'">standalonegc-enabled</StandaloneGCSupportName>
    </PropertyGroup>

    <ItemGroup>
      <NativeLibrary Include="$(IlcSdkPath)bootstrapper.obj" />
      <NativeLibrary Include="$(IlcSdkPath)$(FullRuntimeName).lib" />
      <NativeLibrary Include="$(IlcSdkPath)$(EventPipeName).lib" />
      <NativeLibrary Include="$(IlcSdkPath)$(VxSortSupportName).lib" Condition="Exists('$(IlcSdkPath)$(VxSortSupportName).lib')" />
      <NativeLibrary Include="$(IlcSdkPath)$(StandaloneGCSupportName).lib" />
      <NativeLibrary Include="$(IlcSdkPath)aotminipal.lib" />
      <NativeLibrary Include="$(IlcSdkPath)zlibstatic.lib" />
      <NativeLibrary Include="$(IlcSdkPath)brotlicommon.lib" />
      <NativeLibrary Include="$(IlcSdkPath)brotlienc.lib" />
      <NativeLibrary Include="$(IlcSdkPath)brotlidec.lib" />
      <!-- Zstandard is part of the runtime pack since .NET 11. -->
      <NativeLibrary Include="$(IlcSdkPath)zstd_static.lib" Condition="Exists('$(IlcSdkPath)zstd_static.lib')" />
    </ItemGroup>

    <ItemGroup>
      <NetCoreAppNativeLibrary Include="System.Globalization.Native" />
      <NetCoreAppNativeLibrary Include="System.IO.Compression.Native" />
    </ItemGroup>

    <ItemGroup>
      <DirectPInvoke Include="@(NetCoreAppNativeLibrary)" />
      <NativeLibrary Include="@(NetCoreAppNativeLibrary->'$(IlcSdkPath)%(Identity).Aot.lib')" />

      <!-- The list ships next to the NativeAOT targets, which ILCompilerTargetsPath points into. -->
      <DirectPInvokeList Include="$([System.IO.Path]::Combine($([System.IO.Path]::GetDirectoryName($(ILCompilerTargetsPath))), 'WindowsAPIs.txt'))" />
    </ItemGroup>
  </Target>

  <!--
    Writes down what is linked and how. MSBuild decides by time stamps whether a target has to run; this file
    changes exactly when the link would produce something else, for example when only an option of the link
    changed and the object file is still up to date.
  -->
  <Target Name="_InaWriteLinkOptions" DependsOnTargets="$(LinkNativeDependsOn)">

    <PropertyGroup>
      <_InaPositionIndependent>true</_InaPositionIndependent>
      <_InaPositionIndependent Condition="'$(PositionIndependentExecutable)' == 'false'">false</_InaPositionIndependent>

      <!-- NativeAOT strips symbols by default; StripSymbols=false keeps the symbol table. Windows has none. -->
      <_InaEmitSymbolTable>false</_InaEmitSymbolTable>
      <_InaEmitSymbolTable Condition="'$(StripSymbols)' == 'false' and '$(_InaTargetsWindows)' != 'true'">true</_InaEmitSymbolTable>
    </PropertyGroup>

    <!--
      What the original passes to link.exe besides the inputs: /ENTRY, /SUBSYSTEM, /STACK and /MERGE. The runtime
      locates the managed code by the bounds of its part of the code section, which is why it is merged.
    -->
    <PropertyGroup Condition="'$(_InaTargetsWindows)' == 'true'">
      <_InaEntryPoint>$(EntryPointSymbol)</_InaEntryPoint>
      <_InaSubsystem>$(LinkerSubsystem)</_InaSubsystem>
      <_InaStackSize>$(IlcDefaultStackSize)</_InaStackSize>
      <_InaMergedSections Condition="'$(IlcMergeSections)' != 'false'">.managedcode=.text;hydrated=.bss</_InaMergedSections>
    </PropertyGroup>

    <ItemGroup>
      <_InaLinkInput Include="$(NativeObject);@(NativeLibrary)" />
      <_InaMergedSection Include="$(_InaMergedSections)" />

      <_InaLinkOption Include="--linker:$(InaTasksAssembly)" />
      <_InaLinkOption Include="--rid:$(RuntimeIdentifier)" />
      <_InaLinkOption Include="--output:$(NativeBinary)" />
      <_InaLinkOption Include="--exports:$(ExportsFile)" />
      <_InaLinkOption Include="--position-independent:$(_InaPositionIndependent)" />
      <_InaLinkOption Include="--symbol-table:$(_InaEmitSymbolTable)" />
      <_InaLinkOption Include="--entry:$(_InaEntryPoint)" Condition="'$(_InaEntryPoint)' != ''" />
      <_InaLinkOption Include="--subsystem:$(_InaSubsystem)" Condition="'$(_InaSubsystem)' != ''" />
      <_InaLinkOption Include="--stack:$(_InaStackSize)" Condition="'$(_InaStackSize)' != ''" />
      <_InaLinkOption Include="@(_InaMergedSection->'--merge:%(Identity)')" />
      <_InaLinkOption Include="@(_InaLinkInput)" />
    </ItemGroup>

    <WriteLinesToFile File="$(_InaLinkOptionsFile)" Lines="@(_InaLinkOption)" Overwrite="true" WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <FileWrites Include="$(_InaLinkOptionsFile)" />
    </ItemGroup>
  </Target>

  <Target Name="LinkNative"
          Inputs="@(_InaLinkInput);$(_InaLinkOptionsFile)"
          Outputs="$(NativeBinary)"
          DependsOnTargets="$(LinkNativeDependsOn);_InaWriteLinkOptions">

    <!-- Arguments for clang or link.exe cannot be translated, so they are not silently dropped. -->
    <Warning Code="INA1005" Condition="'@(LinkerArg)' != ''"
             Text="Ina does not run a native linker, so these linker arguments are ignored: @(LinkerArg, ' ')" />

    <InaLink Inputs="@(_InaLinkInput)"
             OutputPath="$(NativeBinary)"
             RuntimeIdentifier="$(RuntimeIdentifier)"
             ExportsFile="$(ExportsFile)"
             PositionIndependent="$(_InaPositionIndependent)"
             EmitSymbolTable="$(_InaEmitSymbolTable)"
             EntryPoint="$(_InaEntryPoint)"
             Subsystem="$(_InaSubsystem)"
             StackSize="$(_InaStackSize)"
             MergedSections="$(_InaMergedSections)" />
  </Target>

</Project>
